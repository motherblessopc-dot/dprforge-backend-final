# Required environment variables (do NOT commit real values)
# In Railway, set these in the project Variables tab.

# MongoDB connection — use Railway's MongoDB plugin OR MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=dprforge_db

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=https://www.dprforge.com,https://dprforge.com

# JWT secret — generate a random 32+ char string
JWT_SECRET=replace-me-with-a-32-character-random-secret

# Admin allowlist + seed credentials (auto-creates admin on every boot)
# Only emails listed here get admin privileges (including Google sign-in via /admin-login).
ADMIN_EMAILS=motherblessopc@gmail.com
ADMIN_SEED_EMAIL=motherblessopc@gmail.com
ADMIN_SEED_PASSWORD=Admin1234
ADMIN_SEED_NAME=Mother Bless Admin

# Emergent universal LLM key (for AI narrative generation)
EMERGENT_LLM_KEY=sk-emergent-xxxxxxxx
