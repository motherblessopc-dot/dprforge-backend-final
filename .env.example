# ============================================================
# DPRForge — Production environment (pre-configured for dprforge.com)
# Rename this file to `.env` before starting the backend.
# Update the values marked with <FILL_ME> before deploying.
# ============================================================

# --- MongoDB ---
# Use MongoDB Atlas (free tier works), Railway Mongo plugin, or any hosted Mongo.
# Example: mongodb+srv://dprforge:<PASSWORD>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=dprforge_db

# --- CORS (your frontend origins) ---
# Pre-set for dprforge.com. Add more origins (comma-separated) if needed.
CORS_ORIGINS=https://www.dprforge.com,https://dprforge.com

# --- JWT signing secret (>= 32 random chars) ---
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dprforge_super_secret_key_2026_secure

# --- Admin allowlist & seed (DO NOT leave blank — admin won't be created) ---
ADMIN_EMAILS=motherblessopc@gmail.com
ADMIN_SEED_EMAIL=motherblessopc@gmail.com
ADMIN_SEED_PASSWORD=Admin123
ADMIN_SEED_NAME=Mother Bless Admin

# --- Optional: Emergent universal LLM key (for "Generate AI narrative" button) ---
# Leave blank to disable AI narrative — rest of the app works fine.
EMERGENT_LLM_KEY=
